<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarStats</AssemblyName>
    <RootNamespace>TaskbarStats</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.5.0</Version>
    <!-- Zuinig: geen extra achtergrond-GC-thread, minder opstart-optimalisatie, geheugen krap houden -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hulpprogramma's en tests zijn eigen projecten: hun bestanden horen niet in de app -->
    <Compile Remove="tools\**;tests\**" />
    <EmbeddedResource Remove="tools\**;tests\**" />
    <None Remove="tools\**;tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarStats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- PerformanceCounter zit op moderne .NET in dit NuGet-pakket -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- Temperatuur/klok/VRAM (optioneel, dezelfde engine als HWiNFO) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
    <!-- WMI voor de specificatiepagina (hardware-inventaris) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Elke build controleert de taalbestanden tegen de code (tools\LangTool): fouten (kapotte {0}, meervoud, dubbele sleutel, Loc-aanroep
       zonder vaste tekst) laten de build mislukken; ontbrekende vertalingen zijn waarschuwingen (-p:LangStrict=true maakt ze fouten).
       Overslaan: -p:SkipLangCheck=true -->
  <Target Name="CheckLang" AfterTargets="CoreCompile" Condition="'$(SkipLangCheck)' != 'true' And Exists('$(MSBuildProjectDirectory)\tools\LangTool\LangTool.csproj')"
          Inputs="@(Compile);$(MSBuildProjectDirectory)\lang\*.json" Outputs="$(IntermediateOutputPath)langcheck.stamp">
    <PropertyGroup><LangArgs Condition="'$(LangStrict)' == 'true'">--strict</LangArgs></PropertyGroup>
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\tools\LangTool\LangTool.csproj&quot; -c Release --verbosity quiet -- check $(LangArgs) --root &quot;$(MSBuildProjectDirectory)&quot;" />
    <Touch Files="$(IntermediateOutputPath)langcheck.stamp" AlwaysCreate="true" />
  </Target>

</Project>
