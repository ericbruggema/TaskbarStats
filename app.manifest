<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="TaskbarStats.app" type="win32" />

  <!-- Vraag administrator-rechten: nodig voor temperatuur-sensoren (LibreHardwareMonitor).
       Wil je zonder UAC-prompt starten, zet requestedExecutionLevel op asInvoker. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- DPI-awareness wordt via het project geregeld (ApplicationHighDpiMode),
       niet via dit manifest — dat is de door WinForms aanbevolen manier. -->

  <!-- Windows 10/11 compat -->
  <compatibility xmlns="urn:schemas-microsoft-com:asm.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
